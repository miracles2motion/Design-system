# Forma Token Studio — environment variables
#
# SECURITY: Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server
# and are NEVER exposed to the browser. Variables WITH the prefix are
# embedded in the client bundle and visible to anyone.
#
# Only the backend URL is public (it's not a secret). The token and the
# moderator password are server-side secrets.

# Community design-sharing backend (Apps Script web app deployment URL).
# This is a URL, not a secret — safe to expose to the browser.
NEXT_PUBLIC_FORMA_COMMUNITY_API=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# --- Server-side secrets (NEVER exposed to the browser) ---

# Auth token for write operations (createSubmission, etc.). Must match the
# webapp_token value in the Config tab of your Google Sheet.
FORMA_COMMUNITY_TOKEN=change-this-token

# Password to access the moderation queue. Required for listing pending
# submissions and approving/rejecting them.
FORMA_MODERATOR_PASSWORD=change-this-password
