# Forma Token Studio — environment variables
#
# Next.js exposes variables prefixed with NEXT_PUBLIC_ to the browser.
# Copy this file to .env.local for local development, or configure them in
# your deployment platform's environment settings.

# Community design-sharing backend (Apps Script web app deployment URL).
# Leave empty to disable the community backend; the app then shows only the
# curated starter library. Copy from your Apps Script web app deployment.
NEXT_PUBLIC_FORMA_COMMUNITY_API=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Auth token for write operations (createSubmission, etc.). Must match the
# webapp_token value in the Config tab of your Google Sheet.
NEXT_PUBLIC_FORMA_COMMUNITY_TOKEN=change-this-token
